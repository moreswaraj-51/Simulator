<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Interactive Virtual Chemistry Lab</title>
  <style>
    * { box-sizing: border-box; user-select: none; }
    body {
      margin: 0;
      background: #0f172a;
      color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Left Sidebar: Reagent Shelf */
    #sidebar {
      width: 320px;
      background: #1e293b;
      border-right: 1px solid #334155;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-y: auto;
    }
    h2 { margin: 0; font-size: 16px; letter-spacing: 0.5px; color: #38bdf8; }
    h3 { margin: 8px 0 4px 0; font-size: 12px; color: #94a3b8; text-transform: uppercase; }
    
    .grid-btns {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }
    button.item-btn {
      background: #334155;
      border: 1px solid #475569;
      color: #f1f5f9;
      padding: 8px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.15s, border-color 0.15s;
    }
    button.item-btn:hover {
      background: #475569;
      border-color: #38bdf8;
    }
    button.item-btn span.sym {
      color: #38bdf8;
      font-family: monospace;
      font-weight: bold;
    }

    /* Main Workspace */
    #workspace {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      background: radial-gradient(circle at center, #1e293b 0%, #0b1120 100%);
    }

    /* Beaker Simulation */
    #beaker-container {
      position: relative;
      width: 200px;
      height: 280px;
      border-left: 5px solid rgba(255, 255, 255, 0.4);
      border-right: 5px solid rgba(255, 255, 255, 0.4);
      border-bottom: 6px solid rgba(255, 255, 255, 0.6);
      border-radius: 0 0 20px 20px;
      background: rgba(255, 255, 255, 0.03);
      box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.05), 0 15px 35px rgba(0,0,0,0.5);
      overflow: hidden;
      display: flex;
      flex-direction: column-reverse;
    }
    
    /* Graduations / measurement ticks */
    .ticks {
      position: absolute;
      left: 8px;
      top: 30px;
      bottom: 30px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      pointer-events: none;
    }
    .tick {
      width: 14px;
      height: 2px;
      background: rgba(255, 255, 255, 0.25);
    }

    #liquid {
      width: 100%;
      height: 0%;
      background: rgba(255, 255, 255, 0.1);
      transition: height 0.4s ease, background-color 0.5s ease;
      position: relative;
    }

    /* Stirrer Bar / Sediment */
    #solids-bed {
      position: absolute;
      bottom: 0;
      width: 100%;
      height: 0px;
      background: #cbd5e1;
      transition: height 0.3s;
    }

    /* Gas bubbles */
    .bubble {
      position: absolute;
      bottom: 0;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 50%;
      animation: rise 1.2s infinite linear;
    }
    @keyframes rise {
      0% { transform: translateY(0) scale(0.6); opacity: 1; }
      100% { transform: translateY(-220px) scale(1.2); opacity: 0; }
    }

    /* Diagnostics Dashboard */
    #telemetry {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 280px;
      background: rgba(30, 41, 59, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 14px;
      font-size: 13px;
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-family: monospace;
    }
    .stat-val { font-weight: bold; }
    
    /* Action controls */
    #controls {
      margin-top: 24px;
      display: flex;
      gap: 10px;
    }
    button.action {
      background: #0284c7;
      border: none;
      color: white;
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }
    button.action:hover { background: #0369a1; }
    button#reset-btn { background: #dc2626; }
    button#reset-btn:hover { background: #b91c1c; }

    /* Reaction Log */
    #log-container {
      margin-top: 15px;
      width: 480px;
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 6px;
      height: 90px;
      overflow-y: auto;
      padding: 8px 12px;
      font-size: 12px;
      font-family: monospace;
      color: #38bdf8;
    }
    .log-item { margin: 2px 0; }
    .log-warn { color: #f87171; }
  </style>
</head>
<body>

  <!-- Shelf: Simple elements & solvents -->
  <div id="sidebar">
    <h2>Reagent Dispensary</h2>
    
    <h3>Solvents</h3>
    <div class="grid-btns">
      <button class="item-btn" onclick="addReagent('H2O')">Water <span class="sym">H₂O</span></button>
      <button class="item-btn" onclick="addReagent('C2H5OH')">Ethanol <span class="sym">EtOH</span></button>
    </div>

    <h3>Elements</h3>
    <div class="grid-btns">
      <button class="item-btn" onclick="addReagent('H2')">Hydrogen <span class="sym">H₂</span></button>
      <button class="item-btn" onclick="addReagent('O2')">Oxygen <span class="sym">O₂</span></button>
      <button class="item-btn" onclick="addReagent('Na')">Sodium <span class="sym">Na</span></button>
      <button class="item-btn" onclick="addReagent('Cl2')">Chlorine <span class="sym">Cl₂</span></button>
      <button class="item-btn" onclick="addReagent('C')">Carbon <span class="sym">C</span></button>
      <button class="item-btn" onclick="addReagent('S')">Sulfur <span class="sym">S</span></button>
      <button class="item-btn" onclick="addReagent('Fe')">Iron <span class="sym">Fe</span></button>
      <button class="item-btn" onclick="addReagent('Cu')">Copper <span class="sym">Cu</span></button>
    </div>

    <h3>Reagents & Acids/Bases</h3>
    <div class="grid-btns">
      <button class="item-btn" onclick="addReagent('HCl')">Hydrochloric <span class="sym">HCl</span></button>
      <button class="item-btn" onclick="addReagent('NaOH')">Lye <span class="sym">NaOH</span></button>
    </div>
  </div>

  <!-- Interactive Lab Bench -->
  <div id="workspace">
    <div id="beaker-container">
      <div class="ticks">
        <div class="tick"></div>
        <div class="tick"></div>
        <div class="tick"></div>
        <div class="tick"></div>
      </div>
      <div id="solids-bed"></div>
      <div id="liquid"></div>
    </div>

    <div id="controls">
      <button class="action" onclick="stirVigorously()">Stir Mixture</button>
      <button class="action" onclick="applyHeat()">Heat (+50°C)</button>
      <button class="action" id="reset-btn" onclick="cleanBeaker()">Clean Beaker</button>
    </div>

    <div id="log-container">
      <div class="log-item">> Lab bench ready. Add solvents or elements.</div>
    </div>
  </div>

  <!-- Real-time Diagnostics -->
  <div id="telemetry">
    <h3 style="margin-top:0;">Vessel Diagnostics</h3>
    <div class="stat-row"><span>Volume:</span><span id="vol-disp" class="stat-val">0 mL</span></div>
    <div class="stat-row"><span>Temperature:</span><span id="temp-disp" class="stat-val">25.0 °C</span></div>
    <div class="stat-row"><span>Calculated pH:</span><span id="ph-disp" class="stat-val">7.0</span></div>
    <div class="stat-row"><span>Contents:</span><span id="mix-disp" class="stat-val">Empty</span></div>
  </div>

  <script>
    // State Tracker
    const flask = {
      volume: 0,        // mL
      temperature: 25.0,// Celsius
      inventory: {},    // { key: moles }
      pH: 7.0,
      effervescing: false
    };

    function log(msg, isWarn = false) {
      const container = document.getElementById('log-container');
      const item = document.createElement('div');
      item.className = isWarn ? 'log-item log-warn' : 'log-item';
      item.textContent = `> ${msg}`;
      container.appendChild(item);
      container.scrollTop = container.scrollHeight;
    }

    function addReagent(item) {
      flask.inventory[item] = (flask.inventory[item] || 0) + 1.0;
      
      // Liquids contribute directly to volume
      if (item === 'H2O' || item === 'C2H5OH' || item === 'HCl' || item === 'NaOH') {
        flask.volume = Math.min(250, flask.volume + 35);
      }

      log(`Added 1 mole / unit of ${item}`);
      evaluateReactions();
      renderUI();
    }

    // Reaction & Synthesis Engine
    function evaluateReactions() {
      const inv = flask.inventory;

      // 1. Formation of Salt (2Na + Cl2 -> 2NaCl)
      if (inv['Na'] >= 2 && inv['Cl2'] >= 1) {
        inv['Na'] -= 2;
        inv['Cl2'] -= 1;
        inv['NaCl'] = (inv['NaCl'] || 0) + 2;
        flask.temperature += 45; // Exothermic
        log("Synthesis: 2Na + Cl₂ → 2NaCl (Sodium Chloride formed!)");
      }

      // 2. Hydrogen Combustion / Water synthesis (2H2 + O2 -> 2H2O)
      if (inv['H2'] >= 2 && inv['O2'] >= 1) {
        inv['H2'] -= 2;
        inv['O2'] -= 1;
        inv['H2O'] = (inv['H2O'] || 0) + 2;
        flask.volume = Math.min(250, flask.volume + 40);
        flask.temperature += 65;
        triggerBubbles();
        log("Combustion: 2H₂ + O₂ → 2H₂O + Heat");
      }

      // 3. Vigorous Alkali Reaction (2Na + 2H2O -> 2NaOH + H2)
      if (inv['Na'] >= 1 && inv['H2O'] >= 1) {
        inv['Na'] -= 1;
        inv['H2O'] -= 1;
        inv['NaOH'] = (inv['NaOH'] || 0) + 1;
        inv['H2'] = (inv['H2'] || 0) + 0.5;
        flask.temperature += 55;
        triggerBubbles();
        log("Exothermic: 2Na + 2H₂O → 2NaOH + H₂↑ (Vigorous reaction!)", true);
      }

      // 4. Acid-Base Neutralization (HCl + NaOH -> NaCl + H2O)
      if (inv['HCl'] >= 1 && inv['NaOH'] >= 1) {
        inv['HCl'] -= 1;
        inv['NaOH'] -= 1;
        inv['NaCl'] = (inv['NaCl'] || 0) + 1;
        inv['H2O'] = (inv['H2O'] || 0) + 1;
        flask.temperature += 28;
        log("Neutralization: HCl + NaOH → NaCl + H₂O");
      }

      // 5. Iron Sulfide Synthesis (Fe + S -> FeS) requires heat or manual mixing
      if (inv['Fe'] >= 1 && inv['S'] >= 1 && flask.temperature >= 70) {
        inv['Fe'] -= 1;
        inv['S'] -= 1;
        inv['FeS'] = (inv['FeS'] || 0) + 1;
        log("Synthesis: Fe + S → FeS (Iron (II) Sulfide formed)");
      }

      // 6. Rust / Oxidation (4Fe + 3O2 -> 2Fe2O3)
      if (inv['Fe'] >= 4 && inv['O2'] >= 3) {
        inv['Fe'] -= 4;
        inv['O2'] -= 3;
        inv['Fe2O3'] = (inv['Fe2O3'] || 0) + 2;
        log("Oxidation: 4Fe + 3O₂ → 2Fe₂O₃ (Iron Oxide / Rust)");
      }

      // Remove 0-count species
      for (let k in inv) {
        if (inv[k] <= 0.001) delete inv[k];
      }

      calculatePH();
    }

    function calculatePH() {
      const inv = flask.inventory;
      const hcl = inv['HCl'] || 0;
      const naoh = inv['NaOH'] || 0;

      if (hcl > naoh) {
        flask.pH = Math.max(1.0, 7.0 - (hcl - naoh) * 2.2);
      } else if (naoh > hcl) {
        flask.pH = Math.min(14.0, 7.0 + (naoh - hcl) * 2.2);
      } else {
        flask.pH = 7.0;
      }
    }

    function stirVigorously() {
      log("Stirring vessel contents...");
      evaluateReactions();
      renderUI();
    }

    function applyHeat() {
      flask.temperature += 50;
      log(`Heated beaker. Temperature is now ${flask.temperature.toFixed(1)}°C`);
      evaluateReactions();
      renderUI();
    }

    function cleanBeaker() {
      flask.volume = 0;
      flask.temperature = 25.0;
      flask.inventory = {};
      flask.pH = 7.0;
      document.getElementById('liquid').style.height = '0%';
      document.getElementById('solids-bed').style.height = '0px';
      log("Cleaned beaker and flushed all contents.");
      renderUI();
    }

    function triggerBubbles() {
      const liquid = document.getElementById('liquid');
      for (let i = 0; i < 8; i++) {
        const b = document.createElement('div');
        b.className = 'bubble';
        b.style.left = `${Math.random() * 85 + 5}%`;
        b.style.width = b.style.height = `${Math.random() * 6 + 4}px`;
        b.style.animationDelay = `${Math.random() * 0.5}s`;
        liquid.appendChild(b);
        setTimeout(() => b.remove(), 1200);
      }
    }

    function renderUI() {
      // Diagnostic meters
      document.getElementById('vol-disp').innerText = `${flask.volume} mL`;
      document.getElementById('temp-disp').innerText = `${flask.temperature.toFixed(1)} °C`;
      document.getElementById('ph-disp').innerText = flask.pH.toFixed(1);

      // Contents list
      const items = Object.entries(flask.inventory)
        .map(([k, v]) => `${k} (${v})`)
        .join(', ');
      document.getElementById('mix-disp').innerText = items || "Empty";

      // Liquid Height & Color Rendering
      const liquid = document.getElementById('liquid');
      const solids = document.getElementById('solids-bed');
      const pct = Math.min(100, (flask.volume / 250) * 100);
      liquid.style.height = `${pct}%`;

      // Color computation based on pH & active components
      let color = 'rgba(255, 255, 255, 0.15)'; // base transparent
      if (flask.inventory['Cu']) color = 'rgba(56, 189, 248, 0.65)'; // Copper blue tinge
      else if (flask.inventory['Fe2O3']) color = 'rgba(185, 28, 28, 0.7)'; // Rust reddish
      else if (flask.pH < 4) color = 'rgba(239, 68, 68, 0.6)'; // Universal indicator Acid = Red
      else if (flask.pH > 10) color = 'rgba(59, 130, 246, 0.6)'; // Base = Blue
      else if (flask.inventory['NaCl']) color = 'rgba(241, 245, 249, 0.35)'; // Saline cloudy
      
      liquid.style.backgroundColor = color;

      // Sediment height for unreacted heavy elements
      let solidMoles = (flask.inventory['Fe'] || 0) + (flask.inventory['C'] || 0) + (flask.inventory['FeS'] || 0);
      solids.style.height = `${Math.min(40, solidMoles * 10)}px`;
    }

    // Passive temperature cooling loop
    setInterval(() => {
      if (flask.temperature > 25.0) {
        flask.temperature = Math.max(25.0, flask.temperature - 0.5);
        document.getElementById('temp-disp').innerText = `${flask.temperature.toFixed(1)} °C`;
      }
    }, 1000);
  </script>
</body>
</html>
